# App Configuration
APP_NAME=MultiAgent KIA Posyandu Airmadidi
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/multiagent_kia_db

# LLM Provider Configuration ("google" atau "koboillm")
LLM_PROVIDER=google

# Google Gemini LLM API (Native)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# KoboiLLM Gateway (Optional / Alternative Provider)
KOBOILLM_API_KEY=your_koboillm_api_key_here
KOBOILLM_BASE_URL=https://api.koboillm.com/v1
KOBOILLM_MODEL=gemini/gemini-3.1-pro-preview

# ChromaDB Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=kia_guidelines_v2

# WeasyPrint Native DLLs for Windows (optional)
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin

